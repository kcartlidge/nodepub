<?xml version='1.0' encoding='utf-8'?>
<package xmlns='http://www.idpf.org/2007/opf' version='2.0' unique-identifier='BookId'>
  <metadata xmlns:dc='http://purl.org/dc/elements/1.1/' xmlns:opf='http://www.idpf.org/2007/opf'>
<% if (appendSeriesToTitle && series && sequence) { -%>
    <dc:title><%- title %> (<%- series %> #<%- sequence %>)</dc:title>
<% } else if (appendSeriesToTitle && series) { -%>
    <dc:title><%- title %> (<%- series %>)</dc:title>
<% } else if (appendSeriesToTitle && sequence) { -%>
    <dc:title><%- title %> (#<%- sequence %>)</dc:title>
<% } else { -%>
    <dc:title><%- title %></dc:title>
<% } -%>
    <dc:identifier id='BookId' opf:scheme='URI'><%- id %></dc:identifier>
    <dc:language><%- language %></dc:language>
    <dc:creator opf:role='aut' opf:file-as='<%- fileAs %>'><%- author %></dc:creator>
    <dc:publisher><%- publisher %></dc:publisher>
    <dc:description><%- description %></dc:description>
    <dc:coverage></dc:coverage>
    <dc:source><%- source %></dc:source>
    <dc:date opf:event='publication'><%- published %></dc:date>
    <dc:date opf:event='modification'><%- modified %></dc:date>
    <dc:rights><%- copyright %></dc:rights>
<% if (genre) { -%>
    <dc:subject><%- genre %></dc:subject>
<% } -%>
<% if (tags) { tags.split(',').forEach((tag) => { -%>
    <dc:subject><%- tag %></dc:subject>
<% }) } -%>
<% if (series && sequence) { -%>
    <meta name='calibre:series' content='<%- series %>'/>
    <meta name='calibre:series_index' content='<%- sequence %>'/>
<% } -%>
    <meta name='cover' content='cover-image'/>
  </metadata>
  <manifest>
    <item id='cover-image' media-type='<%- imageType(imageName(cover)) %>' href='images/<%- imageName(cover) %>'/>
<% if (addInternalCover) { -%>
    <item id='cover' media-type='application/xhtml+xml' href='cover.xhtml'/>
<% } -%>
    <item id='navigation' media-type='application/x-dtbncx+xml' href='navigation.ncx'/>
<% sections.forEach((section, i) => { -%>
    <item id='s<%- i + 1 %>' media-type='application/xhtml+xml' href='content/<%- section.filename %>'/>
<% }) -%>
<% if (showContents) { -%>
    <item id='toc' media-type='application/xhtml+xml' href='content/toc.xhtml'/>
<% } -%>
    <item id='css' media-type='text/css' href='css/ebook.css'/>
<% images.forEach((image, i) => { const type = imageType(image); if (type.length > 0) { -%>
    <item id='img<%- i %>' media-type='<%- type %>' href='images/<%- imageName(image) %>'/>
<% } }) -%>
  </manifest>
  <spine toc='navigation'>
<% if (addInternalCover) { -%>
    <itemref idref='cover' linear='yes' />
<% } -%>
<% sections.forEach((section, i) => { if (section.isFrontMatter) { -%>
    <itemref idref='s<%- i + 1 %>' />
<% } }) -%>
<% if (showContents) { -%>
    <itemref idref='toc'/>
<% } -%>
<% sections.forEach((section, i) => { if (!section.isFrontMatter) { -%>
    <itemref idref='s<%- i + 1 %>' />
<% } }) -%>
  </spine>
<% if (showContents) { -%>
  <guide>
    <reference type='toc' title='Contents' href='content/toc.xhtml'></reference>
  </guide>
<% } -%>
</package>
